IMMICH_URL=https://your-immich-instance.com
IMMICH_API_KEY=your_api_key

# Ollama runs on the home lab server, not locally (text model only — no vision)
OLLAMA_HOST=http://homelab-host:11434
OLLAMA_MODEL=llama3.2

# Phase 1 throttling — max NEW assets to scan/cluster in one run
MAX_ASSETS_PER_RUN=1000

# Clustering: a new album/event starts when the gap since the previous
# asset's date exceeds this many days, or the location changes.
CLUSTER_GAP_DAYS=3
